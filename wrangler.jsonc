{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundryrx",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      "node_modules",
      "wrangler.jsonc",
      ".gitignore"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
